# ==========================================
# MENPS Backend — Environment Configuration
# ==========================================
# Copy this file to `.env` and fill in real values.

# General
APP_NAME="AI Mentorship Platform for Women (MENPS)"
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Database
# SQLite for local dev (default). For production, switch to PostgreSQL, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/menps
DATABASE_URL=sqlite:///./menps.db

# JWT / Security
SECRET_KEY=change-this-to-a-long-random-secret-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (comma-separated list is NOT supported directly by pydantic-settings
# list parsing from .env by default; prefer JSON array syntax below)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Gemini / Google Generative AI
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
